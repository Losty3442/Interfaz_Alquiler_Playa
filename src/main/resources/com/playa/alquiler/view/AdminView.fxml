<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.playa.alquiler.controller.AdminController" styleClass="app-root" stylesheets="@/com/playa/alquiler/style/app.css">
    <top>
        <HBox spacing="10" styleClass="top-bar">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Panel de Administrador" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="currentUserLabel"/>
            <Button text="Cerrar sesión" onAction="#onLogout"/>
        </HBox>
    </top>
    <center>
        <SplitPane>
            <items>
                <VBox spacing="8" prefWidth="250" styleClass="card">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Acciones" style="-fx-font-weight: bold;"/>
                    <Button text="Gestionar Usuarios" onAction="#mostrarGestionUsuarios" styleClass="secondary-btn"/>
                    <Button text="Gestionar Promociones" onAction="#mostrarGestionPromociones" styleClass="secondary-btn"/>
                    <Button text="Gestionar Tarifas" onAction="#mostrarGestionTarifas" styleClass="secondary-btn"/>
                    <Button text="Gestionar Recursos" onAction="#mostrarGestionRecursos" styleClass="secondary-btn"/>
                    <Button text="Ver Reportes" onAction="#mostrarReportes" styleClass="secondary-btn"/>
                </VBox>
                <StackPane fx:id="contenidoStack">
                    <!-- Panel Usuarios -->
                    <VBox fx:id="usuariosPane" spacing="8" styleClass="card">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Usuarios" style="-fx-font-weight: bold;"/>
                        <TableView fx:id="usuariosTable" prefHeight="300" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                                <TableColumn fx:id="colNombre" text="Usuario" prefWidth="120"/>
                                <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                                <TableColumn fx:id="colRol" text="Rol" prefWidth="120"/>
                            </columns>
                        </TableView>
                        <Separator/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="nuevoUsuarioField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="nuevoEmailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Contraseña:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <PasswordField fx:id="nuevoContrasenaField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Rol:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="rolCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                        <HBox spacing="10">
                            <Button text="Crear Usuario" onAction="#onCrearUsuario" styleClass="primary-btn"/>
                            <Button text="Eliminar Seleccionado" onAction="#onEliminarSeleccionado" styleClass="danger-btn"/>
                        </HBox>
                        <Label fx:id="estadoAdminLabel"/>
                    </VBox>

                    <!-- Panel Promociones -->
                    <VBox fx:id="promocionesPane" spacing="8" visible="false" managed="false" styleClass="card">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Promociones" style="-fx-font-weight: bold;"/>
                        <TableView fx:id="promosTable" prefHeight="300" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colPromoId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colPromoNombre" text="Nombre" prefWidth="160"/>
                                <TableColumn fx:id="colPromoTipo" text="Tipo" prefWidth="120"/>
                                <TableColumn fx:id="colPromoValor" text="Valor" prefWidth="120"/>
                                <TableColumn fx:id="colPromoEstado" text="Estado" prefWidth="120"/>
                            </columns>
                        </TableView>
                        <Separator/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="promoNombreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="promoTipoCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Valor:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="promoValorField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Estado:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="promoEstadoCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                        <HBox spacing="10">
                            <Button text="Crear Promoción" onAction="#onCrearPromocion" styleClass="primary-btn"/>
                            <Button text="Eliminar Seleccionada" onAction="#onEliminarPromocion" styleClass="danger-btn"/>
                        </HBox>
                    </VBox>

                    <!-- Panel Tarifas -->
                    <VBox fx:id="tarifasPane" spacing="8" visible="false" managed="false" styleClass="card">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Tarifas por Recurso" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="ID Recurso:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="tarifaRecursoIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Button text="Listar" onAction="#onListarTarifasPorRecurso" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="secondary-btn"/>
                        </GridPane>
                        <TableView fx:id="tarifasTable" prefHeight="240" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colTarifaId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colTarifaPrecio" text="Precio/Hora" prefWidth="120"/>
                                <TableColumn fx:id="colTarifaInicio" text="Inicio" prefWidth="120"/>
                                <TableColumn fx:id="colTarifaFin" text="Fin" prefWidth="120"/>
                            </columns>
                        </TableView>
                        <Separator/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="Precio/Hora:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="tarifaPrecioField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Fecha Inicio:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="tarifaInicioPicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Fecha Fin (opcional):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="tarifaFinPicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>
                        <HBox spacing="10">
                            <Button text="Agregar Tarifa" onAction="#onCrearTarifa" styleClass="primary-btn"/>
                        </HBox>
                    </VBox>

                    <!-- Panel Recursos -->
                    <VBox fx:id="recursosPane" spacing="8" visible="false" managed="false" styleClass="card">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Recursos" style="-fx-font-weight: bold;"/>
                        <TableView fx:id="recursosTable" prefHeight="240" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colRecId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colRecNombre" text="Nombre" prefWidth="160"/>
                                <TableColumn fx:id="colRecTipo" text="Tipo" prefWidth="120"/>
                                <TableColumn fx:id="colRecEstado" text="Estado" prefWidth="120"/>
                            </columns>
                        </TableView>
                        <Separator/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="recursoNombreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Descripción" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="recursoDescripcionField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Tipo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="recursoTipoField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Estado" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="recursoEstadoCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                        <HBox spacing="10">
                            <Button text="Crear" onAction="#onCrearRecurso" styleClass="primary-btn"/>
                            <Button text="Actualizar Seleccionado" onAction="#onActualizarRecurso" styleClass="secondary-btn"/>
                            <Button text="Eliminar Seleccionado" onAction="#onEliminarRecurso" styleClass="danger-btn"/>
                            <Button text="Marcar En Mantenimiento" onAction="#onMarcarMantenimiento" styleClass="secondary-btn"/>
                            <Button text="Marcar Disponible" onAction="#onMarcarDisponible" styleClass="secondary-btn"/>
                        </HBox>
                    </VBox>

                    <!-- Panel Reportes -->
                    <VBox fx:id="reportesPane" spacing="8" visible="false" managed="false" styleClass="card">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Reportes rápidos" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblEnCurso" text="En curso: -"/>
                        <Label fx:id="lblFinalizados" text="Finalizados: -"/>
                        <Separator/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="Top N Recursos" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="topNField" promptText="Ej: 5" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Button text="Ver Top" onAction="#onTopRecursos" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="secondary-btn"/>
                        </GridPane>
                        <ListView fx:id="listaTopRecursos" prefHeight="120"/>
                        <Separator/>
                        <Button text="Recursos en Mantenimiento" onAction="#onRecursosMantenimiento" styleClass="secondary-btn"/>
                        <ListView fx:id="listaMantenimiento" prefHeight="120"/>
                        <Separator/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="Tarifa vigente (Recurso/Fecha)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="recursoIdTarifaField" promptText="ID Recurso" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <DatePicker fx:id="fechaTarifaPicker" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <Button text="Consultar" onAction="#onTarifaVigente" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="secondary-btn"/>
                        </GridPane>
                        <Label fx:id="lblTarifaVigente"/>
                    </VBox>
                </StackPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>